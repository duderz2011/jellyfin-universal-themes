<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Universal Themes | Jellyfin</title><link rel="stylesheet" href="styles.css?v=1.8.0"></head><body data-theme="netflix-style"><div id="login" class="login"><form id="loginForm"><h1>Universal Themes</h1><p>Sign in with your Jellyfin account.</p><label>Username<input id="username" autocomplete="username" required></label><label>Password<input id="password" type="password" autocomplete="current-password"></label><button type="submit">Sign in</button><p id="loginStatus" role="status"></p></form></div><div id="app" hidden><header><a class="brand" href="#" id="homeLink">UNIVERSAL <span>THEMES</span></a><nav id="libraryNav" aria-label="Your Jellyfin libraries"></nav><label class="genre-label" for="genreSelect">Genres <select id="genreSelect"><option value="">All genres</option></select></label><label class="search">Search <input id="search" placeholder="Search this section" autocomplete="off"></label><select id="theme" aria-label="Theme"><option value="netflix-style">Netflix style</option><option value="prime-style">Prime style</option><option value="disney-style">Disney+ style</option></select><button type="button" id="signout">Log out</button></header><main><section id="hero" class="hero" aria-label="Featured content"><div class="hero-content"><span class="kicker" id="heroKicker">YOUR LIBRARY</span><h1 id="heroTitle">Browse your library</h1><p id="heroDescription"></p><button type="button" id="heroOpen" hidden>View details</button><div id="featuredControls" class="featured-controls" hidden><button type="button" id="featuredPrev" aria-label="Previous featured title">❮</button><div id="featuredDots" class="featured-dots" aria-label="Featured titles"></div><button type="button" id="featuredNext" aria-label="Next featured title">❯</button></div></div></section><p id="status" role="status" aria-live="polite"></p><div id="rows"></div></main><dialog id="details"><button id="closeDetails" class="close-details" type="button" aria-label="Close details">✕</button><h2 id="detailsTitle"></h2><p id="detailsMeta"></p><p id="detailsOverview"></p><button id="playTitle" type="button">Play now</button><p id="playStatus" role="status"></p><div id="episodeList" class="episode-list"></div><button id="jellyfinDetails" type="button" hidden>Open in Jellyfin</button></dialog><dialog id="player" class="player-dialog"><div class="player-head"><strong id="playerTitle">Playing</strong><button id="closePlayer" type="button">Close player ✕</button></div><div id="nextEpisodePrompt" class="next-episode-prompt" hidden role="status" aria-live="polite">
  <strong id="nextEpisodeTitle">Next episode</strong>
